[Unit]
Description=Xiaozhi to n8n MCP Bridge
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple

# Upstream xiaozhi-mcp-proxy installation
WorkingDirectory=/mnt/docker/xiaozhi-mcp-bridge

# Private environment variables are stored outside Git.
# Never upload this file to GitHub.
EnvironmentFile=/etc/xiaozhi-mcp-bridge.env

ExecStart=/mnt/docker/xiaozhi-mcp-bridge/venv/bin/python /mnt/docker/xiaozhi-mcp-bridge/mcp_pipe.py /mnt/docker/xiaozhi-mcp-bridge/mcp_stdio_client.py

Restart=always
RestartSec=3

# Basic service hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
