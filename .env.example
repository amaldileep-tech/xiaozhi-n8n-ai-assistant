# -----------------------------
# n8n
# -----------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost

# Set a public editor/webhook URL only if you intentionally expose n8n.
# Example:
# N8N_EDITOR_BASE_URL=https://n8n.example.com
# WEBHOOK_URL=https://n8n.example.com

GENERIC_TIMEZONE=Asia/Dubai

# -----------------------------
# Bridge
# -----------------------------
# Use a TEST webhook while developing.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook-test/xiaozhi

# Optional shared secret.
# Never put the real value in Git.
BRIDGE_SHARED_SECRET=CHANGE_ME_LOCALLY

# Optional command used by the generic stdio launcher.
# Example only:
MCP_COMMAND=python3 -u mcp_pipe.py

# -----------------------------
# External integrations
# -----------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
